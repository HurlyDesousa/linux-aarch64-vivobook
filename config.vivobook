# ASUS Vivobook S15 S5507QA (x1e80100) fragment.
# Merged on top of Arch Linux ARM core/linux-aarch64 config.
#
# RESET_GPIO: WSA speaker amp reset. Live 7.2.0-2 has this unset;
# ALARM master currently sets =m. Built-in so the codec can deassert
# reset without waiting on a module.
CONFIG_RESET_GPIO=y
#
# IRIS video decode. Cheap if the QCOM media stack is already present.
# Still needs qcvss8380.mbn in firmware (not in this repo).
CONFIG_VIDEO_QCOM_IRIS=m
#
# OV02C10 front camera sensor module -- Phase A (2026).
# Module compiled but NOT bound in Phase A (no sensor DTS node yet).
# HUNCH: sensor is OV02C10 on CCI1 i2c1 @ 0x36; must be confirmed
# by post-boot i2cdetect once CCI adapters appear (Phase B).
# The ALARM base config already enables all required infrastructure:
#   CONFIG_VIDEO_QCOM_CAMSS=m  (CAMSS ISP driver)
#   CONFIG_I2C_QCOM_CCI=m      (CCI I2C adapter driver)
#   CONFIG_CLK_X1E80100_CAMCC=m (Camera clock controller)
#   CONFIG_MEDIA_CAMERA_SUPPORT=y
#   CONFIG_V4L_PLATFORM_DRIVERS=y
# This fragment only adds the sensor driver module.
CONFIG_VIDEO_OV02C10=m
