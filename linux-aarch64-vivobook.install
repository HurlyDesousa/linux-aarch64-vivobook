post_install() {
  cat <<MSG
linux-aarch64-vivobook installed (stock linux-aarch64 left in place).

Rebuild the Omarchy UKI and reboot:

  sudo limine-update

Expected UKI: /boot/EFI/Linux/omarchy_linux-aarch64-vivobook.efi
Keep the old omarchy_linux-aarch64.efi as fallback.
MSG
}

post_upgrade() {
  if findmnt --fstab -uno SOURCE /boot &>/dev/null && ! mountpoint -q /boot; then
    echo "WARNING: /boot appears to be a separate partition but is not mounted."
  fi
  echo "Run: sudo limine-update"
}

post_remove() {
  echo "Removed linux-aarch64-vivobook. Stock linux-aarch64 is unchanged. Run: sudo limine-update"
}
