post_install() {
  cat <<MSG
linux-aarch64-vivobook installed.

Rebuild the Omarchy UKI and reboot:

  sudo limine-update

UKI path on this laptop: /boot/EFI/Linux/omarchy_linux-aarch64.efi

This package Provides: linux=7.2 so Limine/mkinitcpio keep working.
MSG
}

post_upgrade() {
  if findmnt --fstab -uno SOURCE /boot &>/dev/null && ! mountpoint -q /boot; then
    echo "WARNING: /boot appears to be a separate partition but is not mounted."
  fi
  echo "Run: sudo limine-update"
}

post_remove() {
  echo "Removed linux-aarch64-vivobook. Install linux-aarch64 again, then: sudo limine-update"
}
