+/*
+ * acca195 / ebs-efivar-fixed: load-time 4 KiB NV write worked (banner
+ * only). late-EBS enter never appeared because upstream registers
+ * efi_late_ebs only after EfiDtbTableGuid + at least one prepared
+ * remoteproc. Keymap-only Limine unlock skips dtbloader → no GUID →
+ * remotecount=0 → callback never registered → pil_finish_all never
+ * runs. SetVariable at EBS was never attempted on that boot.
+ *
+ * Always register late-EBS at load. Persist remotecount + register
+ * status so a zero-remote boot still proves the callback exists.
+ */
+static EFI_STATUS efi_register_late_ebs(void)
+{
+	EFI_STATUS status;
+
+	if (ebs_event)
+		return EFI_SUCCESS;
 
-	return EFI_SUCCESS;
