diff --git a/src/log.c b/src/log.c
new file mode 100644
index 0000000..f2a3b2b
--- /dev/null
+++ b/src/log.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Persist pil_finish stages so Omarchy can read INIT vs AUTH without ConOut.
+ *
+ * LIVE 72634c6: QebspilAdsp == USB log (931 B) — only load-time Firmware
+ * path lines (repeated once). No stage=INIT|AUTH. Paths/carveouts sane.
+ * Late EBS still AUTH'd DTB (0x24:0). pil_finish ran; persist did not.
+ *
+ * Why NV SetVariable fails at EBS: persist *grew* the var (931 B →
+ * stages). That realloc needs SPI/FTW, already down on Insyde 2.9, plus
+ * FAT LibOpenRoot + Print. #14 then deleted the NV var and recreated it
+ * volatile (loglen-sized) — after EBS volatile is read-only / may vanish,
+ * and a growing write still needs a new store slot.
+ *
+ * Fix: keep QebspilAdsp NV|BS|RT (Linux visibility proven). At load,
+ * create it at a fixed 4 KiB. Every persist, including late EBS, is an
+ * in-place same-size update — no FTW realloc, no FAT, no ConOut.
+ *
+ * acca195 LIVE: banner `ebs-efivar-fixed build` OK; rest NUL-padded.
+ * No `late-EBS enter`. That boot skipped dtbloader (keymap-only
+ * Limine unlock). Upstream registers efi_late_ebs only after
+ * EfiDtbTableGuid + remotecount>0, so the callback never existed
+ * and SetVariable at EBS was never tried. This build still uses
+ * the 4 KiB slot; it also always registers late-EBS and always
+ * writes `late-EBS enter remotecount=N`.
+ */
+
+#include <stdarg.h>
+
+#include <efi.h>
+#include <efilib.h>
+
+#include "qebspil.h"
+
+#define LOG_PATH u"\\qebspil-adsp.log"
+#define LOG_MAX 4096
+#define EBS_MAX 256
+#define LOG_ATTR_RAM (EFI_VARIABLE_BOOTSERVICE_ACCESS | \
+		      EFI_VARIABLE_RUNTIME_ACCESS)
+#define LOG_ATTR_NV  (EFI_VARIABLE_NON_VOLATILE | LOG_ATTR_RAM)
+
+static CHAR8 static_logbuf[LOG_MAX];
+static CHAR8 *logbuf = static_logbuf;
+static UINTN loglen;
+static BOOLEAN log_ebs;
+static BOOLEAN log_ready;
+static CHAR8 ebs_slot[EBS_MAX];
+
+static EFI_GUID qebspil_log_guid = {
+	0x6b7c0a11, 0x24e1, 0x4a01,
+	{ 0x9e, 0x80, 0x11, 0xad, 0x50, 0x01, 0x00, 0x24 }
+};
+
+void qebspil_log_enter_ebs(void)
+{
+	log_ebs = TRUE;
+}
+
+static void log_alloc_runtime(void)
+{
+	EFI_STATUS st;
+	VOID *p;
+
+	if (log_ready)
+		return;
+
+	st = BS->AllocatePool(EfiRuntimeServicesData, LOG_MAX, &p);
+	if (!EFI_ERROR(st) && p) {
+		SetMem(p, LOG_MAX, 0);
+		if (loglen)
+			CopyMem(p, static_logbuf, loglen + 1);
+		logbuf = p;
+	}
+
+	log_ready = TRUE;
+}
+
+void qebspil_log(const char *line)
+{
+	UINTN n = 0;
+
+	while (line[n])
+		n++;
+
+	if (loglen + n + 2 <= LOG_MAX) {
+		CopyMem(logbuf + loglen, (VOID *)line, n);
+		loglen += n;
+		logbuf[loglen++] = '\n';
+		logbuf[loglen] = 0;
+	}
+
+	if (!log_ebs)
+		Print(u"%a\n", line);
+}
+
+void qebspil_logf(const char *fmt, ...)
+{
+	va_list ap;
+	CHAR8 line[256];
+
+	va_start(ap, fmt);
+	AsciiVSPrint(line, sizeof(line), (const CHAR8 *)fmt, ap);
+	va_end(ap);
+	qebspil_log((const char *)line);
+}
+
+static EFI_STATUS log_set_named(const CHAR16 *name, UINT32 attr,
+				UINTN size, VOID *data)
+{
+	return RT->SetVariable((CHAR16 *)name, &qebspil_log_guid, attr, size, data);
+}
+
+/*
+ * Always write a fixed-size slot so EBS is an in-place update of a var
+ * that already exists (created at load, when FTW still works).
+ */
+static EFI_STATUS log_set_fixed(const CHAR16 *name, CHAR8 *slot, UINTN cap,
+				const CHAR8 *src, UINTN srclen)
+{
+	EFI_STATUS st;
+	UINTN n = srclen;
+
+	if (n > cap)
+		n = cap;
+	if (slot != src) {
+		SetMem(slot, cap, 0);
+		if (n)
+			CopyMem(slot, (VOID *)src, n);
+	} else if (n < cap) {
+		SetMem(slot + n, cap - n, 0);
+	}
+
+	st = log_set_named(name, LOG_ATTR_NV, cap, slot);
+	if (EFI_ERROR(st))
+		st = log_set_named(name, LOG_ATTR_RAM, cap, slot);
+	return st;
+}
+
+static void log_set_last_line(void)
+{
+	UINTN i, start = 0, n;
+
+	if (!loglen)
+		return;
+	for (i = 0; i < loglen; i++)
+		if (logbuf[i] == '\n' && i + 1 < loglen)
+			start = i + 1;
+	n = loglen - start;
+	if (n && logbuf[start + n - 1] == '\n')
+		n--;
+	log_set_fixed(u"QebspilEbs", ebs_slot, EBS_MAX, logbuf + start, n);
+}
+
+static void log_persist_file(void)
+{
+	EFI_STATUS st;
+	EFI_FILE_HANDLE root, file;
+	UINTN size;
+
+	if (!LoadedImage)
+		return;
+
+	root = LibOpenRoot(LoadedImage->DeviceHandle);
+	if (!root)
+		return;
+
+	st = root->Open(root, &file, LOG_PATH,
+			EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0);
+	if (!EFI_ERROR(st))
+		file->Delete(file);
+
+	st = root->Open(root, &file, LOG_PATH,
+			EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+			0);
+	if (EFI_ERROR(st)) {
+		root->Close(root);
+		return;
+	}
+
+	size = loglen;
+	file->Write(file, &size, logbuf);
+	file->Close(file);
+	root->Close(root);
+}
+
+EFI_STATUS qebspil_log_persist(void)
+{
+	EFI_STATUS st;
+
+	if (!loglen)
+		return EFI_NOT_READY;
+
+	if (!log_ebs)
+		log_alloc_runtime();
+
+	/* Zero-pad to LOG_MAX so EBS does not grow the store. */
+	if (loglen < LOG_MAX)
+		SetMem(logbuf + loglen, LOG_MAX - loglen, 0);
+
+	st = log_set_fixed(u"QebspilAdsp", logbuf, LOG_MAX, logbuf, loglen);
+	log_set_last_line();
+
+	if (log_ebs)
+		return st;
+
+	Print(u"qebspil: log var persist: %r (%d bytes, slot %d)\n",
+	      st, loglen, LOG_MAX);
+	log_persist_file();
+	return st;
+}
