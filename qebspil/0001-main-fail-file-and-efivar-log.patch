diff --git a/src/log.c b/src/log.c
new file mode 100644
index 0000000..e10b661
--- /dev/null
+++ b/src/log.c
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Persist pil_finish stages so Omarchy can read INIT vs AUTH without ConOut.
+ *
+ * LIVE on tip 72634c6: QebspilAdsp and USB \qebspil-adsp.log were identical
+ * load-time Firmware-path lines only — no [MAIN] stage=INIT|AUTH. Late EBS
+ * still AUTH'd DTB (PAS 0x24:0). So pil_finish ran, but persist did not.
+ *
+ * Why: persist used NON_VOLATILE SetVariable (SPI / FTW) and then FAT
+ * LibOpenRoot + Print. At late ExitBootServices those are already gone or
+ * refused (Insyde 2.9). Load-time NV+FAT writes worked; EBS ones did not.
+ *
+ * Fix: RAM-backed Runtime variable (no NON_VOLATILE) as the primary write
+ * at EBS — no flash, no FAT, no ConOut. Same name+GUID QebspilAdsp.
+ * Linux: dd if=.../QebspilAdsp-<guid> bs=1 skip=4
+ */
+
+#include <stdarg.h>
+
+#include <efi.h>
+#include <efilib.h>
+
+#include "qebspil.h"
+
+#define LOG_PATH u"\\qebspil-adsp.log"
+#define LOG_MAX 4096
+#define LOG_ATTR_RAM (EFI_VARIABLE_BOOTSERVICE_ACCESS | \
+		      EFI_VARIABLE_RUNTIME_ACCESS)
+#define LOG_ATTR_NV  (EFI_VARIABLE_NON_VOLATILE | LOG_ATTR_RAM)
+
+static CHAR8 static_logbuf[LOG_MAX];
+static CHAR8 *logbuf = static_logbuf;
+static UINTN loglen;
+static BOOLEAN log_ebs;
+static BOOLEAN log_ready;
+static EFI_PHYSICAL_ADDRESS logbuf_phys;
+
+static EFI_GUID qebspil_log_guid = {
+	0x6b7c0a11, 0x24e1, 0x4a01,
+	{ 0x9e, 0x80, 0x11, 0xad, 0x50, 0x01, 0x00, 0x24 }
+};
+
+void qebspil_log_enter_ebs(void)
+{
+	log_ebs = TRUE;
+}
+
+static void log_alloc_runtime(void)
+{
+	EFI_STATUS st;
+	VOID *p;
+
+	if (log_ready)
+		return;
+
+	/*
+	 * RuntimeServicesData survives EBS if the .efi image (bsdrv) is
+	 * reclaimed. Identity-mapped at AllocatePool time → phys == virt.
+	 */
+	st = BS->AllocatePool(EfiRuntimeServicesData, LOG_MAX, &p);
+	if (!EFI_ERROR(st) && p) {
+		CopyMem(p, static_logbuf, loglen + 1);
+		logbuf = p;
+		logbuf_phys = (EFI_PHYSICAL_ADDRESS)(UINTN)p;
+	} else {
+		logbuf_phys = (EFI_PHYSICAL_ADDRESS)(UINTN)static_logbuf;
+	}
+
+	/* Drop leftover NV QebspilAdsp from 72634c6 (attr mismatch). */
+	RT->SetVariable(u"QebspilAdsp", &qebspil_log_guid, 0, 0, NULL);
+	RT->SetVariable(u"QebspilAdsp", &qebspil_log_guid, LOG_ATTR_NV, 0, NULL);
+
+	log_ready = TRUE;
+}
+
+void qebspil_log(const char *line)
+{
+	UINTN n = 0;
+
+	while (line[n])
+		n++;
+
+	if (loglen + n + 2 <= LOG_MAX) {
+		CopyMem(logbuf + loglen, (VOID *)line, n);
+		loglen += n;
+		logbuf[loglen++] = '\n';
+		logbuf[loglen] = 0;
+	}
+
+	/* ConOut often stalls once EBS is in flight — never Print then. */
+	if (!log_ebs)
+		Print(u"%a\n", line);
+}
+
+void qebspil_logf(const char *fmt, ...)
+{
+	va_list ap;
+	CHAR8 line[256];
+
+	va_start(ap, fmt);
+	AsciiVSPrint(line, sizeof(line), (const CHAR8 *)fmt, ap);
+	va_end(ap);
+	qebspil_log((const char *)line);
+}
+
+static UINTN log_ascii(CHAR8 *buf, UINTN sz, const char *fmt, ...)
+{
+	va_list ap;
+	UINTN n;
+
+	va_start(ap, fmt);
+	n = AsciiVSPrint(buf, sz, (const CHAR8 *)fmt, ap);
+	va_end(ap);
+	return n;
+}
+
+static EFI_STATUS log_set_named(const CHAR16 *name, UINT32 attr,
+				UINTN size, VOID *data)
+{
+	return RT->SetVariable((CHAR16 *)name, &qebspil_log_guid, attr, size, data);
+}
+
+static void log_set_last_line(void)
+{
+	UINTN i, start = 0, n;
+
+	if (!loglen)
+		return;
+	for (i = 0; i < loglen; i++)
+		if (logbuf[i] == '\n' && i + 1 < loglen)
+			start = i + 1;
+	n = loglen - start;
+	if (n && logbuf[start + n - 1] == '\n')
+		n--;
+	/* Compact last-stage var — smaller write if the full buffer is refused. */
+	log_set_named(u"QebspilEbs", LOG_ATTR_RAM, n, logbuf + start);
+}
+
+static void log_persist_file(void)
+{
+	EFI_STATUS st;
+	EFI_FILE_HANDLE root, file;
+	UINTN size;
+
+	if (!LoadedImage)
+		return;
+
+	root = LibOpenRoot(LoadedImage->DeviceHandle);
+	if (!root)
+		return;
+
+	st = root->Open(root, &file, LOG_PATH,
+			EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0);
+	if (!EFI_ERROR(st))
+		file->Delete(file);
+
+	st = root->Open(root, &file, LOG_PATH,
+			EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+			0);
+	if (EFI_ERROR(st)) {
+		root->Close(root);
+		return;
+	}
+
+	size = loglen;
+	file->Write(file, &size, logbuf);
+	file->Close(file);
+	root->Close(root);
+}
+
+void qebspil_log_persist(void)
+{
+	EFI_STATUS st;
+	CHAR8 ptr[80];
+	UINTN ptrlen;
+
+	if (!loglen)
+		return;
+
+	if (!log_ebs)
+		log_alloc_runtime();
+
+	/* Primary: volatile RAM var. No SPI/FTW. Works when FAT is already down. */
+	st = log_set_named(u"QebspilAdsp", LOG_ATTR_RAM, loglen, logbuf);
+	if (EFI_ERROR(st))
+		st = log_set_named(u"QebspilAdsp", LOG_ATTR_NV, loglen, logbuf);
+
+	log_set_last_line();
+
+	if (log_ebs)
+		return;
+
+	/* Load-time only: NV pointer + FAT copy. Never touch FAT at EBS. */
+	if (logbuf_phys) {
+		ptrlen = log_ascii(ptr, sizeof(ptr),
+				   "rt=0x%lx cap=%d used=%d var=0x%lx",
+				   (UINTN)logbuf_phys, LOG_MAX, loglen,
+				   (UINTN)st);
+		log_set_named(u"QebspilPtr", LOG_ATTR_NV, ptrlen, ptr);
+	}
+	Print(u"qebspil: log var persist: %r (%d bytes)\n", st, loglen);
+	log_persist_file();
+}
