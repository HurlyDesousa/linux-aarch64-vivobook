+	qebspil_log_persist();
 
 	status = BS->HandleProtocol(image, &LoadedImageProtocol, (VOID**)&LoadedImage);
 	if (EFI_ERROR(status))
@@ -75,9 +117,19 @@ EFI_STATUS efi_main(EFI_HANDLE image, EFI_SYSTEM_TABLE *system_table)
 	if (EFI_ERROR(status))
 		return status;
 
-	status = event_register_group_callback(&EfiDtbTableGuid, &event, efi_dtb_changed);
+	status = efi_register_late_ebs();
 	if (EFI_ERROR(status))
 		return status;
 
-	return efi_dtb_changed();
+	status = event_register_group_callback(&EfiDtbTableGuid, &event, efi_dtb_changed);
