+/*
+ * Camera Phase A -- CAMSS + CCI enabled, no sensor node.
+ *
+ * HUNCH / TODO: vdd-csiphy supplies are guesses from available Vivobook
+ * PMIC rails. Peer boards (Yoga Slim 7x, T14s) use a pm8010 camera PMIC;
+ * the Vivobook S15 DTS has no pm8010.
+ *   vreg_l1d_0p8 = ldo1 of pmc8380_d  (880-920 mV)  -> 0.8V CSIPHY rail
+ *   vreg_l3e_1p2 = ldo3 of pmc8380_e  (1.2 V)       -> 1.2V CSIPHY rail
+ * Must verify against ASUS BSP schematic before Phase C (sensor enable).
+ * Safe for Phase A: CSIPHY regulators only asserted during streaming.
+ *
+ * CCI1 is enabled (OV02C10 front camera expected on CCI1 i2c1 @ 0x36 --
+ * this is a HUNCH, pending post-boot i2cdetect once CCI adapters appear).
+ * CCI0 is also enabled; sensor assignment unknown at this stage.
+ *
+ * Post-boot verification:
+ *   ls /sys/class/i2c-adapter/
+ *   dmesg | grep -E 'cci|camss|csiphy|qcom-camss'
+ */
+&camss {
+	/* TODO: replace with verified BSP camera regulator rail names */
+	vdd-csiphy-0p8-supply = <&vreg_l1d_0p8>;
+	vdd-csiphy-1p2-supply = <&vreg_l3e_1p2>;
+
+	/* Empty ports: no sensor endpoint in Phase A */
+	ports {};
+
+	status = "okay";
+};
+
+&cci0 {
+	pinctrl-0 = <&cci0_default>;
+	pinctrl-1 = <&cci0_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	status = "okay";
+};
+
+&cci1 {
+	pinctrl-0 = <&cci1_default>;
+	pinctrl-1 = <&cci1_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	status = "okay";
+};
