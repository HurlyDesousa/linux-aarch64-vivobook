-			return ret;
-		}
+static bool qcom_pas_try_attach_lite(struct qcom_pas *pas, int dtb_err)
+{
+	if (!attach_lite_on_dtb_fail || !pas->lite_pas_id)
+		return false;
 
-		ret = qcom_mdt_pas_load(pas->dtb_pas_ctx, pas->dtb_firmware,
-					pas->dtb_firmware_name, pas->dtb_mem_region,
