 }
 
 static void qcom_pas_unmap_carveout(struct rproc *rproc, phys_addr_t mem_phys, size_t size)
@@ -302,10 +312,48 @@
 			goto disable_cx_supply;
 	}
 
+	/*
+	 * UEFI starts lite ADSP for charging. Do not PAS_INIT the replacement
+	 * DTB until proxy PDs and XO are on. Do not shut down lite until DTB
+	 * PAS_INIT succeeds. attach_lite_on_dtb_fail=0 restores
+	 * kill-lite-then-init.
+	 */
+	if (!attach_lite_on_dtb_fail) {
+		qcom_pas_try_shutdown(pas, pas->lite_pas_id, "lite");
+		qcom_pas_try_shutdown(pas, pas->lite_dtb_pas_id, "lite-dtb");
+	}
+	qcom_pas_try_shutdown(pas, pas->dtb_pas_id, "dtb");
+	qcom_pas_try_shutdown(pas, pas->pas_id, "main");
+
