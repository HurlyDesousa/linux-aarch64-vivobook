From: Code Master <code-master@local>
Subject: remoteproc: qcom_q6v5_pas: attach to UEFI lite ADSP if DTB PAS_INIT fails

Keep DTB PAS_INIT after proxy PDs/XO and PAGE-aligned metadata DMA.
Do not shut down lite PAS until DTB init succeeds. If TZ rejects the
DTB on a rproc that has lite_pas_id, attach to the running UEFI lite
ADSP so GLINK/battmgr can work instead of failing start.

--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -83,6 +83,7 @@
 	int dtb_pas_id;
 	int lite_pas_id;
 	int lite_dtb_pas_id;
+	bool lite_attached;
 	unsigned int minidump_id;
 	int crash_reason_smem;
 	unsigned int smem_host_id;
@@ -119,6 +120,11 @@
 	struct qcom_scm_pas_context *dtb_pas_ctx;
 };
 
+static bool attach_lite_on_dtb_fail = true;
+module_param(attach_lite_on_dtb_fail, bool, 0644);
+MODULE_PARM_DESC(attach_lite_on_dtb_fail,
+		 "Attach to UEFI lite ADSP if DTB PAS_INIT fails (default Y)");
+
 static void qcom_pas_segment_dump(struct rproc *rproc,
 				  struct rproc_dump_segment *segment,
 				  void *dest, size_t offset, size_t size)
